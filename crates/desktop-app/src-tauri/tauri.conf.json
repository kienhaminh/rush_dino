{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RushDino",
  "version": "0.1.0",
  "identifier": "ai.rushdino.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "pnpm dev"
    },
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "pnpm build"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RushDino",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 760,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first agent workbench",
    "longDescription": "RushDino is a local-first AI agent platform. The macOS desktop app wraps the Rust agent runtime and provides a Codex-style glassmorphism UI over the same backend the CLI uses.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://releases.rushdino.ai/desktop/{{target}}/{{current_version}}/latest.json"
      ],
      "dialog": false,
      "pubkey": "REPLACE_WITH_GENERATED_ED25519_PUBLIC_KEY"
    }
  }
}
