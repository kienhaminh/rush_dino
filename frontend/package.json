{
  "name": "rushdino-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:common": "tsc -p tsconfig.common.json --noEmit",
    "check:common-imports": "node scripts/check-common-imports.mjs",
    "check:imports": "npm run check:types && npm run check:common && npm run check:common-imports",
    "test:common-characterization": "vitest run src/components/common/*.characterization.node.test.ts src/components/common/usage/*.characterization.node.test.ts --config vitest.node.config.ts"
  },
  "dependencies": {
